# Valid script with fix and compute
units metal
dimension 3
boundary p p p
atom_style atomic

lattice fcc 3.615
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box

pair_style eam/alloy
pair_coeff * * Cu_u3.eam

compute myTemp all temp
fix 1 all nvt temp 300.0 300.0 0.1

timestep 0.001
run 1000

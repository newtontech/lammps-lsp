# Valid LAMMPS input: Lennard-Jones melt simulation
# Based on official LAMMPS examples/melt/in.melt
# Source: https://github.com/lammps/lammps/tree/develop/examples/melt

units       lj
atom_style  atomic
dimension   3
boundary    p p p

# Create simulation box
lattice     fcc 0.8442
region      box block 0 4 0 4 0 4
create_box  1 box
create_atoms 1 box
mass        1 1.0

# Pair potential
pair_style  lj/cut 2.5
pair_coeff  1 1 1.0 1.0 2.5

# Initial velocity
velocity    all create 1.44 87287 loop geom

# Output settings
neighbor    0.3 bin
neigh_modify delay 0 every 20 check no

# Run simulation
fix         1 all nve
run         100

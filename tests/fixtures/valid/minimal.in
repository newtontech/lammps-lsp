# Minimal valid LAMMPS input script
# Self-contained: no external file references
units metal
dimension 3
boundary p p p
atom_style atomic

lattice fcc 3.615
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box

pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5

velocity all create 300.0 87287

timestep 0.001
thermo 100
run 1000

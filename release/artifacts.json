{
  "schema": "lammps-lsp-release-artifacts/v1",
  "package": {
    "name": "lammps-lsp",
    "version": "0.1.0-pre.4",
    "repository": "https://github.com/newtontech/lammps-lsp",
    "tag": "v0.1.0-pre.4"
  },
  "cargoDist": {
    "version": "0.22.1",
    "publish": "github-release-only",
    "installers": [
      "shell",
      "powershell"
    ]
  },
  "binaries": [
    "lammps-analyser",
    "lammps-lsp",
    "lammps-lsp-tool",
    "lmp-lsp"
  ],
  "targets": [
    {
      "triple": "aarch64-apple-darwin",
      "archive": "lammps-lsp-aarch64-apple-darwin.tar.xz"
    },
    {
      "triple": "x86_64-apple-darwin",
      "archive": "lammps-lsp-x86_64-apple-darwin.tar.xz"
    },
    {
      "triple": "x86_64-unknown-linux-gnu",
      "archive": "lammps-lsp-x86_64-unknown-linux-gnu.tar.xz"
    },
    {
      "triple": "x86_64-pc-windows-msvc",
      "archive": "lammps-lsp-x86_64-pc-windows-msvc.zip"
    }
  ],
  "globalAssets": [
    "dist-manifest.json",
    "lammps-lsp-installer.sh",
    "lammps-lsp-installer.ps1",
    "source.tar.gz",
    "source.tar.gz.sha256"
  ]
}
